/* DXWeaver v0.5.1 design system — application-wide dark cockpit */
QWidget {
    background-color: #0B0F14;
    color: #E6EDF3;
    selection-background-color: #214B72;
    selection-color: #FFFFFF;
    font-family: "Segoe UI";
}

QMainWindow, QDialog, QFrame, QGroupBox, QTabWidget::pane {
    background-color: #0B0F14;
    color: #E6EDF3;
}

QFrame#dxwHud,
QFrame#dxwCandidateMatrix {
    background-color: #111821;
    border: 1px solid #263341;
    border-radius: 6px;
}

QLabel#dxwBrand,
QLabel#dxwMatrixTitle {
    color: #E6EDF3;
    font-weight: 700;
}

QLabel#dxwState,
QLabel#dxwMatrixSummary {
    color: #9FB0C0;
    font-weight: 600;
}

QLabel#dxwState[fault="true"] {
    color: #FF7B72;
}

QPushButton,
QToolButton {
    background-color: #162536;
    color: #E6EDF3;
    border: 1px solid #263341;
    border-radius: 4px;
    padding: 5px 10px;
    min-height: 20px;
}

QPushButton:hover,
QToolButton:hover {
    background-color: #1B3044;
    border-color: #4B6680;
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: #0F1D29;
}

QPushButton[dxwStrategy="true"]:checked {
    background-color: #173554;
    border-color: #4EA1FF;
    color: #D9ECFF;
}

QPushButton#dxwArm {
    background-color: #162536;
    border-color: #32465A;
    font-weight: 700;
}

QPushButton#dxwArm:checked {
    background-color: #3A301A;
    border-color: #E7B75B;
    color: #FFE1A3;
}

QPushButton#dxwHalt {
    background-color: #B63A3A;
    border-color: #E45C5C;
    color: #FFFFFF;
    font-weight: 700;
}

QPushButton#dxwHalt:hover {
    background-color: #CA4545;
    border-color: #FF7B72;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QTableView,
QTableWidget,
QListView,
QTreeView {
    background-color: #0D141C;
    color: #E6EDF3;
    border: 1px solid #263341;
    border-radius: 3px;
    alternate-background-color: #101923;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QTableView:focus,
QTableWidget:focus {
    border-color: #4EA1FF;
}

QTableWidget#dxwCandidatesTable {
    background-color: #0B1118;
    alternate-background-color: #0F1720;
    border: 0;
    gridline-color: #1F2B37;
}

QTableWidget#dxwCandidatesTable::item {
    padding: 2px 6px;
    border-bottom: 1px solid #18232E;
}

QTableWidget#dxwCandidatesTable::item:selected {
    background-color: #214B72;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #111821;
    color: #9FB0C0;
    border: 0;
    border-right: 1px solid #1D2A36;
    border-bottom: 1px solid #263341;
    padding: 4px 6px;
    font-weight: 700;
}

QMenuBar,
QMenu,
QToolBar,
QStatusBar {
    background-color: #111821;
    color: #E6EDF3;
    border-color: #263341;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background-color: #1B3044;
}

QTabBar::tab {
    background-color: #111821;
    color: #9FB0C0;
    border: 1px solid #263341;
    padding: 5px 9px;
}

QTabBar::tab:selected {
    background-color: #162536;
    color: #E6EDF3;
    border-bottom-color: #4EA1FF;
}

QGroupBox {
    border: 1px solid #263341;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 7px;
    padding: 0 3px;
    color: #9FB0C0;
}

QCheckBox,
QRadioButton {
    spacing: 5px;
    color: #E6EDF3;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: #0B0F14;
    border: 0;
    margin: 0;
}

QScrollBar:vertical { width: 10px; }
QScrollBar:horizontal { height: 10px; }

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #334454;
    border-radius: 4px;
    min-height: 20px;
    min-width: 20px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #465C70;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: 0;
}

QToolTip {
    background-color: #111821;
    color: #E6EDF3;
    border: 1px solid #4B6680;
    padding: 4px;
}
